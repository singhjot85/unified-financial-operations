# ============================================
# PROJECT NAMING
# ============================================
COMPOSE_PROJECT_NAME=unfo
PROJECT_NAME=unfo
ENVIRONMENT=dev
VERSION=dev
REGISTRY=localhost

# ============================================
# CONTAINER NAMES
# ============================================
DJANGO_CONTAINER=${PROJECT_NAME}-backend-${ENVIRONMENT}
FRONTEND_CONTAINER=${PROJECT_NAME}-frontend-${ENVIRONMENT}
POSTGRES_CONTAINER=${PROJECT_NAME}-postgres-${ENVIRONMENT}
CACHE_CONTAINER=${PROJECT_NAME}-cache-${ENVIRONMENT}
BROKER_CONTAINER=${PROJECT_NAME}-broker-${ENVIRONMENT}
CELERY_CONTAINER=${PROJECT_NAME}-celery-${ENVIRONMENT}
CELERYBEAT_CONTAINER=${PROJECT_NAME}-celerybeat-${ENVIRONMENT}

# ============================================
# IMAGE NAMES
# ============================================
DJANGO_IMAGE=${REGISTRY}/${PROJECT_NAME}/backend:${VERSION}
FRONTEND_IMAGE=${REGISTRY}/${PROJECT_NAME}/frontend:${VERSION}
POSTGRES_IMAGE=postgres:16-alpine
VALKEY_IMAGE=valkey/valkey:8.1.5-alpine

# ============================================
# VOLUME NAMES
# ============================================
PG_VOLUME=${PROJECT_NAME}_pg_data_${ENVIRONMENT}
REDIS_VOLUME=${PROJECT_NAME}_cache_data_${ENVIRONMENT}
BROKER_VOLUME=${PROJECT_NAME}_broker_data_${ENVIRONMENT}

# ============================================
# NETWORK NAMES
# ============================================
NETWORK_NAME=${PROJECT_NAME}_network_${ENVIRONMENT}

# ============================================
# SERVICE PORTS
# ============================================
DJANGO_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
CACHE_PORT=6379
BROKER_PORT=6378
CELERY_FLOWER_PORT=5555

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unfo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# REDIS/VALKEY CONFIGURATION
# ============================================
REDIS_URL=redis://cache:6379/0
BROKER_URL=redis://broker:6378/0
CELERY_BROKER_URL=redis://broker:6378/0
CELERY_RESULT_BACKEND=redis://cache:6379/0

# ============================================
# DJANGO CONFIGURATION
# ============================================
DJANGO_SETTINGS_MODULE=core.settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:${DJANGO_PORT}
VITE_APP_ENV=${ENVIRONMENT}
